# Required for auth / dashboards / live data
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — AI (Vercel AI SDK + xAI Grok)
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# Optional — Stripe billing (4 Days AI AB account for Done Under).
# Billing is switched on only when the four server vars below are set (lib/feature-flags.ts).
# Use test-mode values (sk_test_/rk_test_, whsec_ from `stripe listen`) locally and on Preview.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ids (price_...): USD 190 one-time search, USD 250/month Unlimited
STRIPE_PRICE_ONE_TIME=
STRIPE_PRICE_MONTHLY=
# Only needed if Stripe.js / embedded Checkout is added later (hosted Checkout redirect does not use it)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional — Hermes / Telegram agent API
HERMES_AGENT_SECRET=

# Optional — comma-separated usernames that can use school outreach tools in Hermes (default: gareth)
SCHOOL_OUTREACH_USERNAMES=

# Optional — Resend email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_DOMAIN=
RESEND_INBOUND_DOMAIN=inbound.doneunder.ai
RESEND_WEBHOOK_SECRET=

# Optional — cron
CRON_SECRET=

# Optional — ops alerts (stuck divers daily check)
OPS_ALERT_EMAIL=hazzler@gmail.com
